# Backend environment variables — copy to .env and fill in real values.
# Never commit .env.

# Supabase connection string (port 5432; NEVER the transaction pooler on 6543 — it rejects DDL).
# Direct connection (db.<ref>.supabase.co) is IPv6-only and unreachable from IPv4-only networks,
# so use the SESSION POOLER (works everywhere):
#   postgresql+psycopg://postgres:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# NOTE: the pooler identifies the project via the username → user MUST be "postgres.<project-ref>".
DATABASE_URL=

# Secret key for signing JWT access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

APP_NAME="AI Business Automation Platform"
DEBUG=false

# AI engine used for ticket analysis. D2 resolved 2026-09-28: Ollama (cloud or local).
#   mock    — deterministic, offline, no deps (default; used by tests/seed)
#   ollama  — real model via the Ollama API (Ollama cloud or a local install)
AI_PROVIDER=mock

# Ollama settings (only used when AI_PROVIDER=ollama).
# CLOUD (recommended — no install needed): create a key at ollama.com →
# Settings → API keys, then use the ollama.com endpoint. The free plan includes
# a monthly starter allowance for starter models (e.g. gpt-oss:20b).
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
# LOCAL alternative (100% free / unlimited, needs the Ollama app + a pulled model):
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.2
#   OLLAMA_API_KEY=            (leave empty — local Ollama needs no auth)
# Per-request timeout; generous for remote/cold-start inference.
OLLAMA_TIMEOUT_SECONDS=60
