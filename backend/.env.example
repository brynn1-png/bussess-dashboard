# Backend environment variables — copy to .env and fill in real values.
# Never commit .env.

# Supabase connection string.
# For Alembic migrations use the DIRECT or SESSION connection (port 5432).
# Do NOT use the transaction pooler (port 6543) — it rejects DDL statements.
# Format: postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

APP_NAME="AI Business Automation Platform"
DEBUG=false
